# Copy to .env.local (ignored by git). Only this key belongs in the browser bundle.
# Matterport SDK key for the 3D tour overlay.
NEXT_PUBLIC_MATTERPORT_SDK_KEY=

# Optional, server-side only: where Next proxies /api/*. Default http://127.0.0.1:8000
# API_URL=http://127.0.0.1:8000

# Optional: 1 shows hand-typed DEMO sample spaces when the API has no data. Leave unset for real runs.
# NEXT_PUBLIC_DEMO_FALLBACK=1
